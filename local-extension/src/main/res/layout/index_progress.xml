<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/phase" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorOnSurface" />
    <TextView android:id="@+id/media_counts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        app:trackThickness="4dp" app:trackCornerRadius="2dp" android:max="1000" />
    <TextView android:id="@+id/processing_counts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    <TextView android:id="@+id/context_counts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
    <TextView android:id="@+id/eta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" android:visibility="gone" />
    <TextView android:id="@+id/problems" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorError" android:visibility="gone" />
</LinearLayout>
