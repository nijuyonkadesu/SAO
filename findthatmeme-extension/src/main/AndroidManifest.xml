<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <package android:name="one.njk.sao" />
        <package android:name="one.njk.sao.testing" />
    </queries>
    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.FindThatMemeExtension"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_extension">
        <service
            android:name=".FindThatMemeExtensionService"
            android:permission="one.njk.sao.permission.SOURCE_EXTENSION"
            android:label="@string/provider_name"
            android:exported="true">
            <intent-filter><action android:name="one.njk.sao.source.EXTENSION" /></intent-filter>
            <meta-data android:name="one.njk.sao.source.API_VERSION" android:value="1" />
            <meta-data android:name="one.njk.sao.source.SETTINGS" android:value="one.njk.sao.extension.findthatmeme.FindThatMemeSettingsActivity" />
        </service>
        <activity
            android:name=".FindThatMemeSettingsActivity"
            android:permission="one.njk.sao.permission.SOURCE_EXTENSION"
            android:exported="true" />
        <provider
            android:name=".FindThatMemeMediaProvider"
            android:authorities="${applicationId}.media"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
