<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="floating_exports/" />
        <exclude domain="database" path="usage.db" />
        <exclude domain="database" path="usage.db-wal" />
        <exclude domain="database" path="usage.db-shm" />
        <exclude domain="database" path="usage.db-journal" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="floating_exports/" />
        <exclude domain="database" path="usage.db" />
        <exclude domain="database" path="usage.db-wal" />
        <exclude domain="database" path="usage.db-shm" />
        <exclude domain="database" path="usage.db-journal" />
    </device-transfer>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
