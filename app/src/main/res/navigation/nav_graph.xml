<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="one.njk.sao.CarouselFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_carousel">
        <action
            android:id="@+id/action_HomeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment"
            app:enterAnim="@animator/fragment_open_enter" app:exitAnim="@animator/fragment_open_exit"
            app:popEnterAnim="@animator/fragment_close_enter" app:popExitAnim="@animator/fragment_close_exit" />
        <action android:id="@+id/action_HomeFragment_to_usageFragment" app:destination="@id/usageFragment"
            app:enterAnim="@animator/fragment_open_enter" app:exitAnim="@animator/fragment_open_exit"
            app:popEnterAnim="@animator/fragment_close_enter" app:popExitAnim="@animator/fragment_close_exit" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="one.njk.sao.SettingsFragment"
        android:label="@string/action_settings"
        tools:layout="@layout/fragment_settings"/>
    <fragment
        android:id="@+id/usageFragment"
        android:name="one.njk.sao.usage.UsageFragment"
        android:label="@string/usage_title"
        tools:layout="@layout/fragment_usage" />
</navigation>
