<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="one.njk.sao.CarouselFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_carousel">
        <action
            android:id="@+id/action_HomeFragment_to_settingsActivity"
            app:destination="@id/settingsActivity" />
        <action android:id="@+id/action_HomeFragment_to_usageActivity" app:destination="@id/usageActivity" />
    </fragment>
    <activity
        android:id="@+id/settingsActivity"
        android:name="one.njk.sao.SettingsActivity"
        android:label="@string/action_settings" />
    <activity
        android:id="@+id/usageActivity"
        android:name="one.njk.sao.usage.UsageActivity"
        android:label="@string/usage_title" />
</navigation>
