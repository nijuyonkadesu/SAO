<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:title="@string/floating_telegram_apps" app:navigationIcon="@drawable/ic_picker_close" app:navigationContentDescription="@string/floating_close" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/floating_telegram_apps_description" android:paddingVertical="8dp" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/floating_app_search" app:endIconMode="clear_text">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/app_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/apps" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/packages_field" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/floating_manual_packages">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/packages" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine|textNoSuggestions" android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/add_packages" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/floating_add_packages" />
</LinearLayout>
