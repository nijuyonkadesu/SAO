<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="20dp" android:paddingBottom="12dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/extension_catalog_title" android:textAppearance="?attr/textAppearanceTitleMedium" android:accessibilityHeading="true" />
