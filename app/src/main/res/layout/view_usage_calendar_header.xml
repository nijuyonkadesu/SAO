<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginEnd="12dp" android:text="@string/usage_calendar" android:accessibilityHeading="true"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized" android:textColor="?attr/colorOnSurface" />
    <com.google.android.material.button.MaterialButton android:id="@+id/usage_calendar_scale"
        style="@style/Widget.SAO.Usage.DateButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
        app:icon="@drawable/ic_usage_expand" app:iconGravity="textEnd" app:iconSize="20dp" app:iconPadding="4dp" />
</LinearLayout>
