<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/floating_reliability_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:accessibilityHeading="true"
        android:textColor="?attr/colorPrimary" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp" android:text="@string/floating_reliability_description" android:textAppearance="?attr/textAppearanceBodyMedium" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp"
                android:text="@string/floating_battery_optimization" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip android:id="@+id/battery_optimization" style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="false" android:text="@string/floating_battery_checking" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/floating_battery_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp"
                android:text="@string/floating_background_settings" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip android:id="@+id/background_settings" style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="false" android:text="@string/floating_settings_manage"
                android:contentDescription="@string/floating_background_settings" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/floating_background_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <TextView android:id="@+id/reliability_limits" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/floating_reliability_limits" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="24dp" />
</LinearLayout>
