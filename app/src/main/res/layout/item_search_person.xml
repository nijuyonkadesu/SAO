<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="center_vertical" android:paddingVertical="4dp" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">
    <ImageView android:id="@+id/portrait" android:layout_width="48dp" android:layout_height="48dp" android:scaleType="centerCrop" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/person_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:textAppearance="?attr/textAppearanceBodyLarge"/>
    <com.google.android.material.checkbox.MaterialCheckBox android:id="@+id/person_selected" android:layout_width="wrap_content" android:layout_height="wrap_content" android:importantForAccessibility="no"/>
</LinearLayout>
