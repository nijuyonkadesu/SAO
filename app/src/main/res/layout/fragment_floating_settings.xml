<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/floating_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:accessibilityHeading="true"
        android:textColor="?attr/colorPrimary" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/floating_settings_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/session_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:accessibilityLiveRegion="polite" />
    <com.google.android.material.chip.ChipGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">
        <com.google.android.material.chip.Chip
            android:id="@+id/start_stop"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="false"
            android:text="@string/floating_show"
            android:contentDescription="@string/floating_show" />
        <com.google.android.material.chip.Chip
            android:id="@+id/stop_floating"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="false"
            android:text="@string/floating_settings_stop"
            android:contentDescription="@string/floating_stop" />
        <com.google.android.material.chip.Chip
            android:id="@+id/preview"
            style="@style/Widget.Material3.Chip.Assist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="false"
            android:text="@string/floating_settings_preview"
            android:contentDescription="@string/floating_preview" />
    </com.google.android.material.chip.ChipGroup>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="12dp" android:text="@string/floating_show_on_launch" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip android:id="@+id/show_on_launch" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/enabled" />
        </LinearLayout>
        <TextView android:id="@+id/show_on_launch_description" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" android:text="@string/floating_show_on_launch_description" android:textAppearance="?attr/textAppearanceBodyMedium" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/floating_auto_hide"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/auto_hide"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/enabled" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/floating_hide_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/floating_hide_delay"
        android:textAppearance="?attr/textAppearanceTitleMedium" />
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/hide_delay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:singleSelection="true"
        app:selectionRequired="true">
        <com.google.android.material.chip.Chip
            android:id="@+id/delay_three"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/floating_delay_three" />
        <com.google.android.material.chip.Chip
            android:id="@+id/delay_five"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/floating_delay_five" />
        <com.google.android.material.chip.Chip
            android:id="@+id/delay_ten"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:text="@string/floating_delay_ten" />
    </com.google.android.material.chip.ChipGroup>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginBottom="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="16dp" android:text="@string/sequence_setting" android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip android:id="@+id/browse_sequence" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/disabled" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sequence_setting_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/sequence_hold_setting"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <TextView android:id="@+id/long_press_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelLarge" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sequence_hold_description"
        android:textAppearance="?attr/textAppearanceBodyMedium" />
    <com.google.android.material.slider.Slider android:id="@+id/long_press_delay" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginBottom="20dp" android:contentDescription="@string/sequence_hold_setting" android:valueFrom="100" android:valueTo="1000"
        android:stepSize="1" android:value="160" app:tickVisible="false" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/floating_prefer_stickers"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/prefer_stickers"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/enabled" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/floating_stickers_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/sources_title"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/immich_settings"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/floating_settings_manage"
                android:contentDescription="@string/sources_title" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sources_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/floating_telegram_apps"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/telegram_apps"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/floating_settings_choose"
                android:contentDescription="@string/floating_telegram_apps" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/floating_telegram_apps_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/floating_settings_sample_pack"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/add_sample_pack"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/floating_settings_add"
                android:contentDescription="@string/floating_add_pack" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/floating_settings_sample_pack_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/floating_settings_permissions"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:accessibilityHeading="true"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/floating_overlay_permission"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/overlay_permission"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/floating_overlay_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/floating_usage_permission"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/usage_permission"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/floating_usage_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/floating_paste_assistance"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/paste_assistance"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:text="@string/disabled" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/floating_paste_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:text="@string/floating_settings_accessibility"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
            <com.google.android.material.chip.Chip
                android:id="@+id/accessibility_permission"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false" />
        </LinearLayout>
        <TextView
            android:id="@+id/accessibility_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/floating_settings_accessibility_description"
            android:textAppearance="?attr/textAppearanceBodyMedium" />
    </LinearLayout>
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp" />
    <include android:id="@+id/background_reliability" layout="@layout/view_floating_reliability" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/floating_settings_native"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:accessibilityHeading="true"
        android:textColor="?attr/colorPrimary" />
    <TextView
        android:id="@+id/native_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textAppearance="?attr/textAppearanceTitleMedium" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/floating_native_description"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:layout_marginTop="8dp" />
</LinearLayout>
