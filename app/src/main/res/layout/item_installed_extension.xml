<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="4dp" app:cardCornerRadius="16dp" app:strokeWidth="0dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSurfaceContainer">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="4dp">
