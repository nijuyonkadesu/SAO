<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/back" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/source_back" app:icon="@drawable/ic_picker_back" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sources_title" android:textAppearance="?attr/textAppearanceHeadlineMedium" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="12dp" android:text="@string/sources_description" android:textAppearance="?attr/textAppearanceBodyLarge" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/source_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_setup_storage_error" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.button.MaterialButton android:id="@+id/add_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/source_add" />
</LinearLayout>
