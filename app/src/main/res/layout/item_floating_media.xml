<?xml version="1.0" encoding="utf-8"?>
<one.njk.sao.floating.PickerMediaFrame xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    app:shapeAppearance="@style/ShapeAppearance.SAO.Picker.Media" android:layout_width="260dp" android:layout_height="match_parent" android:layout_marginHorizontal="4dp" android:clickable="true" android:focusable="true">
    <com.google.android.material.card.MaterialCardView android:id="@+id/card" android:layout_width="match_parent" android:layout_height="match_parent"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
            <androidx.media3.ui.PlayerView android:id="@+id/video_preview" android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_margin="16dp" android:visibility="gone" android:importantForAccessibility="no" android:focusable="false" android:clickable="false"
                app:use_controller="false" app:surface_type="texture_view" app:resize_mode="fit" app:shutter_background_color="@android:color/transparent" />
            <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:padding="4dp" android:maxLines="1" android:textAppearance="?attr/textAppearanceLabelLarge" android:visibility="gone" />
            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/check" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:padding="4dp" android:scaleType="fitCenter" android:background="@drawable/bg_picker_selected" app:srcCompat="@drawable/ic_picker_check" app:tint="?attr/colorOnPrimary" android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/gif_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_margin="12dp" android:padding="4dp" android:background="@drawable/bg_picker_badge" android:text="@string/picker_gif" android:textColor="?attr/colorOnSurfaceVariant" android:textAppearance="?attr/textAppearanceLabelSmall" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/uploaded_at" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:textColor="?attr/colorOnSurfaceVariant"
            android:textAppearance="?attr/textAppearanceLabelSmall" android:maxLines="2" android:ellipsize="end"
            android:visibility="gone" android:importantForAccessibility="no" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</one.njk.sao.floating.PickerMediaFrame>
