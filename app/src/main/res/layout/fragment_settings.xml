<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="32dp">
        <LinearLayout
            android:id="@+id/nsfw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:text="@string/nsfw_mode"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/nsfw_toggle"
                    style="@style/Widget.SAO.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="@string/enabled" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nsfw_desc"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/exporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:text="@string/export_list"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/exporting_toggle"
                    style="@style/Widget.SAO.Settings.ActionChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="@string/export" app:chipIcon="@drawable/source_chip_download" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/exporting_desc"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/importing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:text="@string/import_list"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/importing_toggle"
                    style="@style/Widget.SAO.Settings.ActionChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="@string/importing" app:chipIcon="@drawable/source_chip_upload" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/importing_desc"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:text="@string/language"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/language_select"
                    style="@style/Widget.SAO.Settings.StatusChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="false"
                    android:text="@string/language_system" app:chipIcon="@drawable/source_chip_public" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/language_desc"
                android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="12dp" android:text="@string/home_categories_title" android:textAppearance="?attr/textAppearanceTitleMedium" />
                <com.google.android.material.chip.Chip android:id="@+id/home_categories" style="@style/Widget.SAO.Settings.ActionChip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="false" android:text="@string/home_categories_manage" app:chipIcon="@drawable/source_chip_edit" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_categories_settings_description" android:textAppearance="?attr/textAppearanceBodyMedium" />
        </LinearLayout>
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/floating_controls"
            android:name="one.njk.sao.floating.FloatingSettingsFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="24dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_sao"
            android:textAppearance="?attr/textAppearanceTitleMedium" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_sao_desc"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
