<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
    <TextView style="@style/SaoSourceSectionHeading" android:text="@string/source_intake_title" />
    <TextView android:id="@+id/intake_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/intake_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:indeterminate="true" />
    <TextView android:id="@+id/intake_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/intake_reload" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_retry" android:visibility="gone" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/intake_target_box" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/source_intake_destination">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/intake_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout android:id="@+id/intake_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/intake_add_media" style="?attr/materialButtonOutlinedStyle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/source_intake_photos" />
        <com.google.android.material.button.MaterialButton android:id="@+id/intake_add_files" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_files" />
    </LinearLayout>
    <TextView android:id="@+id/intake_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:id="@+id/intake_queue_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/intake_pause" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_pause" />
        <com.google.android.material.button.MaterialButton android:id="@+id/intake_retry" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_retry_files" />
        <com.google.android.material.button.MaterialButton android:id="@+id/intake_clear" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_clear" />
    </LinearLayout>
    <LinearLayout android:id="@+id/intake_folder_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/SaoSourceSectionHeading" android:text="@string/source_intake_folders" />
        <LinearLayout android:id="@+id/intake_folders" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <com.google.android.material.button.MaterialButton android:id="@+id/intake_connect_folder" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_intake_connect" />
        <com.google.android.material.button.MaterialButton android:id="@+id/intake_check_folders" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_check" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_intake_folder_help" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
