<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" />
    <TextView android:id="@+id/intake_title" style="@style/SaoSourceSectionHeading" android:text="@string/source_intake_title" />
    <TextView android:id="@+id/intake_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurfaceVariant" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/intake_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:indeterminate="true" />
    <TextView android:id="@+id/intake_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorError" android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <com.google.android.material.chip.Chip android:id="@+id/intake_reload" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_retry" android:visibility="gone" app:chipIcon="@drawable/source_chip_refresh" app:chipIconVisible="true" android:saveEnabled="false" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/intake_target_box" style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/source_intake_destination">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/intake_target" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.chip.ChipGroup android:id="@+id/intake_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/SaoSourceChipGroup">
        <com.google.android.material.chip.Chip android:id="@+id/intake_add_media" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_photos" app:chipIcon="@drawable/source_chip_photo_library" app:chipIconVisible="true" android:saveEnabled="false" />
        <com.google.android.material.chip.Chip android:id="@+id/intake_add_files" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_files" app:chipIcon="@drawable/source_chip_insert_drive_file" app:chipIconVisible="true" android:saveEnabled="false" />
    </com.google.android.material.chip.ChipGroup>
    <TextView android:id="@+id/intake_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textAppearance="?attr/textAppearanceBodyMedium" android:accessibilityLiveRegion="polite" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/intake_queue_actions" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
        <com.google.android.material.chip.Chip android:id="@+id/intake_pause" style="@style/Widget.SaoSource.Chip.Status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_pause" app:chipIcon="@drawable/source_chip_pause" app:chipIconVisible="true" android:saveEnabled="false" />
        <com.google.android.material.chip.Chip android:id="@+id/intake_retry" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_retry_files" app:chipIcon="@drawable/source_chip_refresh" app:chipIconVisible="true" android:saveEnabled="false" />
        <com.google.android.material.chip.Chip android:id="@+id/intake_clear" style="@style/Widget.SaoSource.Chip.Destructive" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_clear" app:chipIcon="@drawable/source_chip_delete" app:chipIconVisible="true" android:saveEnabled="false" />
    </com.google.android.material.chip.ChipGroup>
    <LinearLayout android:id="@+id/intake_folder_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView style="@style/SaoSourceSectionHeading" android:text="@string/source_intake_folders" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/source_intake_folder_help" android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="?attr/colorOnSurfaceVariant" />
        <LinearLayout android:id="@+id/intake_folders" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SaoSourceChipGroup">
            <com.google.android.material.chip.Chip android:id="@+id/intake_connect_folder" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_connect" app:chipIcon="@drawable/source_chip_folder" app:chipIconVisible="true" android:saveEnabled="false" />
            <com.google.android.material.chip.Chip android:id="@+id/intake_check_folders" style="@style/Widget.SaoSource.Chip.Action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/source_intake_check" app:chipIcon="@drawable/source_chip_search" app:chipIconVisible="true" android:saveEnabled="false" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</LinearLayout>
