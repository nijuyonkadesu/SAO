<resources>
    <style name="SaoSourceSectionHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="Widget.SaoSource.Chip.Action" parent="Widget.Material3.Chip.Assist">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:checkable">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:ellipsize">end</item>
        <item name="chipBackgroundColor">@color/source_chip_background</item>
        <item name="chipStrokeColor">@color/source_chip_stroke</item>
        <item name="android:textColor">@color/source_chip_foreground</item>
        <item name="chipIconTint">@color/source_chip_foreground</item>
        <item name="checkedIconTint">@color/source_chip_foreground</item>
        <item name="chipIconSize">18dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="android:saveEnabled">false</item>
    </style>
    <style name="Widget.SaoSource.Chip.Filter" parent="Widget.SaoSource.Chip.Action">
        <item name="android:checkable">true</item>
        <item name="checkedIconVisible">false</item>
        <item name="checkedIcon">@drawable/source_chip_check</item>
    </style>
    <style name="Widget.SaoSource.Chip.Status" parent="Widget.SaoSource.Chip.Action" />
    <style name="Widget.SaoSource.Chip.Destructive" parent="Widget.SaoSource.Chip.Action">
        <item name="android:textColor">@color/source_chip_error</item>
        <item name="chipIconTint">@color/source_chip_error</item>
        <item name="chipStrokeColor">@color/source_chip_error</item>
    </style>
    <style name="SaoSourceChipGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipSpacingHorizontal">8dp</item>
        <item name="chipSpacingVertical">0dp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>
</resources>
